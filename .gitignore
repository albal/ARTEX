/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# the JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key

# the local environment generated by a Docker deployment (contains passwords/keys, not committed)
.env

# the event logs produced by the scheduler running/simulating (test artefacts, not committed)
*-events.csv

# bench benchmark-related (local artefacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2